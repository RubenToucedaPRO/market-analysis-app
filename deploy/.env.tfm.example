# ============================================================
# TFM market-analysis-app — .env de PRODUCCIÓN (VPS)
# Copiar en el VPS como /opt/apps/tfm/.env y luego: chmod 600 /opt/apps/tfm/.env
# NO subir a Git. Nombres idénticos al .env.example local (perfil prod los lee igual).
# Secretos: genera uno distinto por clave con: openssl rand -hex 32
# ============================================================

# --- Spring perfil prod (lo pone el compose; aquí solo informativo) ---
# SPRING_PROFILES_ACTIVE=prod (va en environment de tfm/compose.yml, no aquí)

# --- BD: application-prod.properties lee DB_URL / DB_USER / DB_PASSWORD (sin defaults) ---
# OJO: el host es el servicio mysql (market-analysis-mysql), NO localhost.
DB_URL=jdbc:mariadb://market-analysis-mysql:3306/marketanalysisdb?rewriteBatchedStatements=true
DB_DATABASE=marketanalysisdb
DB_USER=marketuser
DB_PASSWORD=CAMBIAR_openssl_1
DB_ROOT_PASSWORD=CAMBIAR_openssl_2

MARIADB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
MARIADB_PASSWORD=${DB_PASSWORD}
MARIADB_USER=${DB_USER}
MARIADB_DATABASE=${DB_DATABASE}

# --- Login de la app (prod NO puede ser admin/admin) ---
APP_SECURITY_USERNAME=CAMBIAR_openssl_3
APP_SECURITY_PASSWORD=CAMBIAR_openssl_4

# --- APIs e IA (sin defaults: vacías = app coja) ---
FINNHUB_API_TOKEN=CAMBIAR_tu_token_finnhub
POLYGON_API_TOKEN=CAMBIAR_tu_token_polygon
OPENROUTER_API_KEY=CAMBIAR_tu_key_openrouter
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=1000
# FINNHUB_BASE_URL / POLYGON_BASE_URL / FINVIZ_* usan sus defaults: no hace falta ponerlos.

# --- Dominio y Certbot ---
TFM_DOMAIN=tfm.tudominio.es
CERTBOT_EMAIL=tu@email.com

# --- Despliegue / Backup ---
VPS_HOST=xxx.xxx.xxx.xxx
GHCR_REPOSITORY=xxx/repo
TFM_TAG=latest
